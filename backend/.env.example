# The backend also reads the project root .env file.
# Copy this file to backend/.env only if you want backend-specific overrides.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_booking
PORT=3000

# Development-only delay before the INSERT, in milliseconds.
# 0 keeps the delay disabled. Try 1500 to line up two browser tabs.
BOOKING_DELAY_MS=0
